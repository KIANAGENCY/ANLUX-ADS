# =============================================================================
# ANLUX Ads Intelligence — variables de entorno
# =============================================================================
# Copia este archivo a `.env.local` y rellena solo lo que vayas a usar.
# La aplicación funciona completamente en modo mock/demo sin ninguna de estas
# variables definidas. Nunca subas `.env.local` a git (ya está en .gitignore).

# --- Supabase (auth + base de datos) ----------------------------------------
# Panel de Supabase > Project Settings > API Keys (nomenclatura actual: "Publishable key").
# Sin estas dos, el login funciona en modo demo (acepta cualquier credencial).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# La clave secreta (antes "service_role") no se usa en esta fase — se añadirá
# más adelante solo si hace falta saltarse RLS desde el servidor.

# --- Meta Marketing API -------------------------------------------------------
# Único requisito para activar el modo "Meta Real" (lectura): un token de
# acceso con permisos ads_read sobre las cuentas que quieras consultar.
# Sin esta variable, el dashboard sigue funcionando en modo mock/demo.
# Las cuentas publicitarias se descubren automáticamente vía /me/adaccounts,
# no hace falta fijar una cuenta por variable de entorno.
META_ACCESS_TOKEN=
# Opcional: ID del Business Manager cuyas cuentas de CLIENTE deben aparecer
# también en el selector. `/me/adaccounts` solo devuelve las cuentas propias
# del usuario del token; las cuentas de terceros administradas desde un
# Business Manager necesitan además /{business_id}/client_ad_accounts.
# Sin esta variable, el descubrimiento sigue funcionando solo con
# /me/adaccounts.
META_BUSINESS_ID=
# Opcional: fija la versión de Graph API si no quieres usar el valor por
# defecto centralizado en lib/meta/config.ts.
META_GRAPH_API_VERSION=
# Reservadas para una fase futura (OAuth, appsecret_proof...). No se usan
# todavía en ningún sitio del código.
META_APP_ID=
META_APP_SECRET=
META_AD_ACCOUNT_ID=

# --- Proveedor de IA (AI Performance Analyst) ---------------------------------
# Selecciona explícitamente el motor del analista: "anthropic" (por defecto si
# no se define) o "gemini". Un valor distinto provoca un error de configuración
# claro: nunca hay fallback silencioso entre proveedores.
AI_PROVIDER=

# Anthropic — console.anthropic.com > API Keys. Necesaria con AI_PROVIDER=anthropic.
# Solo se usa desde el servidor (/api/ai/analyze); sin ella, el analista
# devuelve un error explícito en vez de un análisis inventado.
ANTHROPIC_API_KEY=

# Google Gemini — aistudio.google.com > API Keys. Necesaria con AI_PROVIDER=gemini.
# Mismas garantías: server-only y sin datos simulados.
GEMINI_API_KEY=
# Opcional: identificador del modelo de Gemini. Sin definir se usa el valor por
# defecto centralizado en lib/ai/config.ts.
GEMINI_MODEL=
