# =============================================================================
# ANLUX Ads Intelligence — variables de entorno
# =============================================================================
# Copia este archivo a `.env.local` y configura únicamente las integraciones
# que vayas a usar. Nunca subas `.env.local` a git (ya está en .gitignore).
#
# PRINCIPIO DE INTEGRIDAD: ANLUX no sustituye credenciales ausentes por datos
# mock/demo. Si una integración necesaria no está configurada, la aplicación
# debe mostrar un estado o error explícito, nunca métricas simuladas.

# --- Supabase (autenticación) -------------------------------------------------
# Panel de Supabase > Project Settings > API Keys.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Exclusiva para procesos programados server-only; nunca se importa en cliente.
SUPABASE_SECRET_KEY=

# Memoria histórica. Después de aplicar la migración y configurar el proceso
# programado, se recomienda habilitarla. El runtime de usuario sigue usando
# exclusivamente sesión autenticada + RLS; el cron usa un carril separado.
ANLUX_MEMORY_ENABLED=true

# --- Meta Marketing API (solo lectura) ---------------------------------------
# Token con permisos de lectura sobre las cuentas publicitarias autorizadas.
# ANLUX lo usa exclusivamente desde código server-only; nunca llega al navegador.
META_ACCESS_TOKEN=

# Opcional: Business Manager cuyas cuentas de cliente también deben descubrirse.
# Si se define, ANLUX combina /me/adaccounts con /{business_id}/client_ad_accounts.
META_BUSINESS_ID=

# Opcional: versión de Graph API. Sin definir se usa el valor centralizado en
# src/lib/meta/config.ts.
META_GRAPH_API_VERSION=

# Reservadas para una futura implementación OAuth/appsecret_proof. No se usan
# en el flujo actual y no son requisito del dashboard.
META_APP_ID=
META_APP_SECRET=
META_AD_ACCOUNT_ID=

# --- Proveedor de IA (AI Performance Analyst) --------------------------------
# Valores soportados: "anthropic" o "gemini".
# Si Gemini falla por saturación o red, se reintenta y después se usa Claude
# como fallback cuando ANTHROPIC_API_KEY también está configurada.
AI_PROVIDER=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Opcional: modelo Gemini; si se omite se usa la configuración central.
GEMINI_MODEL=

# --- Informe diario programado ------------------------------------------------
# Secreto de la cabecera que autoriza el cron diario.
CRON_SECRET=
RESEND_API_KEY=
# No se usa ningún destinatario de respaldo.
ANLUX_BRIEF_RECIPIENT=
