# =============================================================================
# ANLUX Ads Intelligence — variables de entorno
# =============================================================================
# Copia este archivo a `.env.local` y rellena solo lo que vayas a usar.
# La aplicación funciona completamente en modo mock/demo sin ninguna de estas
# variables definidas. Nunca subas `.env.local` a git (ya está en .gitignore).

# --- Supabase (auth + base de datos) ----------------------------------------
# Panel de Supabase > Project Settings > API Keys (nomenclatura actual: "Publishable key").
# Sin estas dos, el login funciona en modo demo (acepta cualquier credencial).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# La clave secreta (antes "service_role") no se usa en esta fase — se añadirá
# más adelante solo si hace falta saltarse RLS desde el servidor.

# --- Meta Marketing API -------------------------------------------------------
# Único requisito para activar el modo "Meta Real" (lectura): un token de
# acceso con permisos ads_read sobre las cuentas que quieras consultar.
# Sin esta variable, el dashboard sigue funcionando en modo mock/demo.
# Las cuentas publicitarias se descubren automáticamente vía /me/adaccounts,
# no hace falta fijar una cuenta por variable de entorno.
META_ACCESS_TOKEN=
# Opcional: fija la versión de Graph API si no quieres usar el valor por
# defecto centralizado en lib/meta/config.ts.
META_GRAPH_API_VERSION=
# Reservadas para una fase futura (OAuth, appsecret_proof...). No se usan
# todavía en ningún sitio del código.
META_APP_ID=
META_APP_SECRET=
META_AD_ACCOUNT_ID=

# --- Anthropic (Claude) -------------------------------------------------------
# console.anthropic.com > API Keys.
# Sin esta variable, el AI Performance Analyst usa análisis simulado
# (lib/ai/mock-analyst.ts). Solo se usa desde el servidor (/api/ai/analyze).
ANTHROPIC_API_KEY=
