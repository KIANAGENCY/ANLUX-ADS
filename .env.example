# =============================================================================
# ANLUX Ads Intelligence — variables de entorno
# =============================================================================
# Copia este archivo a `.env.local` y rellena solo lo que vayas a usar.
# La aplicación funciona completamente en modo mock/demo sin ninguna de estas
# variables definidas. Nunca subas `.env.local` a git (ya está en .gitignore).

# --- Supabase (auth + base de datos) ----------------------------------------
# Panel de Supabase > Project Settings > API.
# Sin estas dos, el login funciona en modo demo (acepta cualquier credencial).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secreto de servidor con acceso total (bypassa RLS). NUNCA exponer al cliente.
SUPABASE_SERVICE_ROLE_KEY=

# --- Meta Marketing API -------------------------------------------------------
# developers.facebook.com > tu app > Configuración básica / Marketing API.
# Sin estas variables, la app usa datos mock (lib/meta/mock-service.ts).
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=

# --- Anthropic (Claude) -------------------------------------------------------
# console.anthropic.com > API Keys.
# Sin esta variable, el AI Performance Analyst usa análisis simulado
# (lib/ai/mock-analyst.ts). Solo se usa desde el servidor (/api/ai/analyze).
ANTHROPIC_API_KEY=
